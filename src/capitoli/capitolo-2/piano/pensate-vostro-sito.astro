---
import Card from "../../../components/Card.astro";
import Grid from "../../../components/Grid.astro";
import Slide from "../../../components/slide/Slide.astro";
---
<Slide {...Astro.props} kicker="2.1 Organizzare un progetto · Tocca a voi" titoloStile="max-width:18ch" titolo="Pensate al vostro sito" lead="Cinque minuti, carta e penna. Le risposte ci servono per tutto il resto del capitolo.">
  <Grid colonne={3} classe="mt-l">
    <Card variante="peach" titolo="Il piatto">Che sito vorreste costruire, e a cosa serve?</Card>
    <Card titolo="Gli ospiti">Per chi è? Chi lo aprirà, e perché?</Card>
    <Card titolo="Gli ingredienti">Cosa avete già: testi, foto, idee, esempi che vi piacciono?</Card>
  </Grid>
</Slide>
