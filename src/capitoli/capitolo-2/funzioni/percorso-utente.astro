---
import Slide from "../../../components/slide/Slide.astro";
---
<Slide {...Astro.props} classe="compact" kicker="2.6 Funzionalità · Il percorso" titolo="Il percorso dell'utente" lead="Dal primo contatto all'obiettivo raggiunto, passo per passo. Ogni passo è un punto in cui la persona può perdersi.">
  <p class="kicker mt-m">Da Rina: un turista cerca dove cenare</p>
  <div class="pipe">
    <div><b>Cerca</b><span>«trattoria Torino» sul telefono</span></div>
    <div><b>Apre il sito</b><span>e capisce subito che è una trattoria</span></div>
    <div><b>Guarda</b><span>il menu della settimana e gli orari</span></div>
    <div><b>Preme</b><span>«Prenota su WhatsApp»</span></div>
    <div><b>Prenota</b><span>con il messaggio già scritto</span></div>
  </div>
  <p class="kicker mt-m">PrenotaAula: una docente prepara la lezione</p>
  <div class="pipe">
    <div><b>Apre il link</b><span>ricevuto dalla segreteria</span></div>
    <div><b>Accede</b><span>con il suo account della scuola</span></div>
    <div><b>Sceglie</b><span>giorno e ora</span></div>
    <div><b>Vede</b><span>solo le aule libere</span></div>
    <div><b>Prenota</b><span>e riceve la conferma</span></div>
  </div>
</Slide>
