---
import Slide from "../../../components/slide/Slide.astro";
---
<Slide {...Astro.props} kicker="2.2 Perché decidere prima" titolo="Quanto costa cambiare idea" lead="Alcune scelte si cambiano in un attimo. Altre sono le fondamenta: cambiarle vuol dire ricominciare.">
  <div class="cost mt-l">
    <div class="cost-row"><span class="w">Cambiare un colore</span><span class="track"><span class="fill" style="width:4%"></span></span><span class="t">un minuto</span></div>
    <div class="cost-row"><span class="w">Riscrivere un testo</span><span class="track"><span class="fill" style="width:8%"></span></span><span class="t">pochi minuti</span></div>
    <div class="cost-row"><span class="w">Aggiungere una pagina</span><span class="track"><span class="fill" style="width:18%"></span></span><span class="t">un'ora</span></div>
    <div class="cost-row"><span class="w">Aggiungere gli account utente</span><span class="track"><span class="fill" style="width:55%"></span></span><span class="t">giorni</span></div>
    <div class="cost-row"><span class="w">Cambiare framework</span><span class="track"><span class="fill" style="width:80%"></span></span><span class="t">si rifà quasi tutto</span></div>
    <div class="cost-row"><span class="w">Da sito ad app per telefono</span><span class="track"><span class="fill" style="width:100%"></span></span><span class="t">si ricomincia</span></div>
  </div>
  <p class="footnote">Tempi indicativi, per un progetto piccolo fatto con l'AI.</p>
</Slide>
