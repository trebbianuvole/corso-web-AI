---
import Def from "../../../components/Def.astro";
import Defs from "../../../components/Defs.astro";
import Slide from "../../../components/slide/Slide.astro";
---
<Slide {...Astro.props} split kicker="2.2 Architettura" titolo="Architettura: dove sta ogni cosa" lead="È il modo in cui il codice è diviso in file e cartelle, e come questi pezzi parlano tra loro. Come la pianta di una cucina: dispensa, fornelli, lavello, sala.">
  <Fragment slot="intro">
  <Defs classe="mt-m">
    <Def termine="Ogni file un compito">una slide per file, uno stile per tutto il sito</Def>
    <Def termine="Nomi che si capiscono"><code>style.css</code>, non <code>file2-nuovo.css</code></Def>
    <Def termine="Niente copie">lo stesso codice in due posti diventa due errori</Def>
  </Defs>
  </Fragment>
  <figure class="figure">
    <pre class="code tree"><span class="m">Il sito di questo corso, fatto con Astro</span>

<span class="d">corso-web-ai/</span>
├── <span class="d">src/</span>
│   ├── <span class="d">pages/</span>       <span class="c">una pagina per indirizzo</span>
│   ├── <span class="d">layouts/</span>     <span class="c">lo scheletro comune</span>
│   ├── <span class="d">components/</span>  <span class="c">i pezzi che si ripetono</span>
│   └── <span class="d">capitoli/</span>    <span class="c">una slide per file</span>
├── <span class="d">public/</span>
│   └── <span class="d">assets/</span>      <span class="c">stile e script</span>
├── <span class="d">docs/</span>          <span class="c">la scaletta</span>
└── CLAUDE.md      <span class="c">le regole per Claude</span></pre>
  </figure>
</Slide>
