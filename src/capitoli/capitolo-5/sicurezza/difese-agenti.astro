---
import Card from "../../../components/Card.astro";
import Grid from "../../../components/Grid.astro";
import Slide from "../../../components/slide/Slide.astro";
---
<Slide {...Astro.props} tipo="checklist" kicker="5.3 Sicurezza con gli agenti" titolo="Le difese" lead="Ricavate dalla simulazione. Nessuna basta da sola: insieme, fermano quasi tutto.">
  <Grid colonne={2} classe="mt-l">
    <Card tag="Passi 1 e 2" titolo="Permessi minimi">L'agente vede solo il repository su cui lavora e non può fare push su main (4.6.a2). I contenuti scritti da estranei si trattano come sospetti.</Card>
    <Card tag="Passi 3 e 4" titolo="Isolamento">Le chiavi vere non stanno nella cartella dove lavora l'agente: in sviluppo si usano chiavi di prova, con pochi poteri.</Card>
    <Card tag="Passo 5" titolo="Controllare le librerie">Ogni dipendenza nuova si verifica prima di installarla (5.3.6).</Card>
    <Card variante="peach" tag="Passo 6" titolo="Conferma prima di ciò che non si annulla">Pubblicare, cancellare, inviare, pagare: l'agente si ferma e chiede. E voi leggete il diff (4.7.4).</Card>
  </Grid>
  <Card variante="sky mt-m" titolo="E sempre">Le chiavi non si scrivono in chat, né si danno all'agente «solo per un attimo».</Card>
</Slide>
