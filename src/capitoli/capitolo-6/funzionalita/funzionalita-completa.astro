---
import Card from "../../../components/Card.astro";
import Passo from "../../../components/Passo.astro";
import Slide from "../../../components/slide/Slide.astro";
import Steps from "../../../components/Steps.astro";
---
<Slide {...Astro.props} tipo="attivita" split kicker="6.5 Una funzionalità alla volta" titolo="Una funzionalità completa" lead="Un'ora, sul vostro progetto. Prendete una delle tre issue del compito 4.8.4 e portatela fino al merge.">
  <Card slot="intro" variante="sky mt-m" titolo="Alla fine, mostrate">La issue chiusa, la pull request con la descrizione, e la funzionalità che va dal telefono.</Card>
  <Steps>
    <Passo titolo="Scomponete" inLinea>la storia in passi (6.5.1)</Passo>
    <Passo titolo="Un ramo" inLinea>con il nome della funzionalità</Passo>
    <Passo titolo="Plan mode" inLinea>e un prompt con i criteri (6.5.2)</Passo>
    <Passo titolo="Passo, prova, commit" inLinea>per ogni passo</Passo>
    <Passo titolo="Un giro di pulizia" inLinea>«semplifica senza cambiare cosa si vede»</Passo>
    <Passo titolo="Pull request e merge" inLinea>con la revisione di un compagno</Passo>
  </Steps>
</Slide>
