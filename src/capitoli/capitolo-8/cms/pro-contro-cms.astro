<Slide {...Astro.props} classe="compact" kicker="8.2 I CMS" titolo="Pro e contro" lead="Non esiste il CMS migliore: esiste quello giusto per quel cliente.">
  <table class="compare mt-m">
    <thead><tr><th></th><th>Tradizionali</th><th>Costruttori</th><th>Headless</th><th>Basati su Git</th></tr></thead>
    <tbody>
      <tr><td>Costi</td><td data-label="Tradizionali">Hosting e manutenzione</td><td data-label="Costruttori">Abbonamento mensile</td><td data-label="Headless">Gratis fino a una soglia, poi a utente</td><td data-label="Basati su Git">Spesso gratis</td></tr>
      <tr><td>Sicurezza</td><td data-label="Tradizionali">Aggiornamenti continui di sistema e plugin</td><td data-label="Costruttori">Ci pensa il fornitore</td><td data-label="Headless">Ci pensa il fornitore</td><td data-label="Basati su Git">Sito statico: poco da attaccare</td></tr>
      <tr><td>Libertà di design</td><td data-label="Tradizionali">Media, legata ai temi</td><td data-label="Costruttori">Bassa</td><td data-label="Headless">Totale</td><td data-label="Basati su Git">Totale</td></tr>
