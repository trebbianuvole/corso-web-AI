      <tr><td>Con l'AI</td><td data-label="Tradizionali">Via plugin e API</td><td data-label="Costruttori">Strumenti propri</td><td data-label="Headless">Via API e MCP</td><td data-label="Basati su Git">Claude legge e modifica i file</td></tr>
    </tbody>
  </table>
</Slide>
