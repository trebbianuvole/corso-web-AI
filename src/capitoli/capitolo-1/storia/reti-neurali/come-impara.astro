---
import Card from "../../../../components/Card.astro";
import Passo from "../../../../components/Passo.astro";
import Slide from "../../../../components/slide/Slide.astro";
import Steps from "../../../../components/Steps.astro";
---
<Slide {...Astro.props} kicker="1.1 Le reti neurali da vicino" titolo="Come impara" lead="Immaginate di scendere a valle nella nebbia: non vedete il fondo, vedete solo da che parte scende il terreno sotto i piedi." split>
  <Steps classe="mt-m" slot="intro">
    <Passo titolo="Prova" inLinea>la rete risponde, con i pesi che ha</Passo>
    <Passo titolo="Misura l'errore" inLinea>quanto è lontana dalla risposta giusta</Passo>
    <Passo titolo="Sposta un po' i pesi" inLinea>nella direzione che riduce l'errore</Passo>
    <Passo titolo="Riprova" inLinea>milioni di volte, con esempi sempre diversi</Passo>
  </Steps>
  <div>
    <figure class="figure"><svg class="diagram" viewBox="0 0 520 300" role="img" aria-labelledby="val-t val-d"><title id="val-t">La discesa nella valle</title><desc id="val-d">Una valle: in alto a sinistra l'errore è grande. Una pallina scende a piccoli passi fino al fondo, dove l'errore è minimo. La parte destra della valle è coperta dalla nebbia.</desc>
<defs><linearGradient id="val-nebbia" x1="0" x2="1" y1="0" y2="0"><stop offset="0" style="stop-color:var(--paper);stop-opacity:0"/><stop offset=".35" style="stop-color:var(--paper);stop-opacity:.9"/><stop offset="1" style="stop-color:var(--paper);stop-opacity:.95"/></linearGradient></defs>
<path d="M20 60 C 120 60, 160 250, 260 250 S 400 60, 500 80" class="valle"/>
<circle cx="55" cy="68" r="9" class="tappa"/>
<circle cx="86" cy="90" r="9" class="tappa"/>
<circle cx="140" cy="155" r="9" class="tappa"/>
<circle cx="194" cy="220" r="9" class="tappa"/>
<circle cx="250" cy="249" r="12" class="tappa-fine"/>
<rect x="240" y="20" width="280" height="250" fill="url(#val-nebbia)"/>
<text x="30" y="36" class="lbl">errore grande</text>
<text x="252" y="288" class="lbl" text-anchor="middle">errore minimo</text>
<text x="430" y="150" class="lbl" text-anchor="middle">nebbia</text>
</svg></figure>
    <Card variante="sky mt-m" titolo="Passi piccoli, ma tanti">Si chiama discesa del gradiente. La lunghezza del passo la sceglie chi addestra: troppo lungo e si salta il fondo, troppo corto e non si arriva mai.</Card>
  </div>
  <p class="footnote" slot="intro">Per approfondire: <a href="https://it.wikipedia.org/wiki/Discesa_del_gradiente" target="_blank" rel="noopener">Discesa del gradiente su Wikipedia</a>.</p>
</Slide>
